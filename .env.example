# Copy to .env in this folder, or just run scripts/setup.py and it writes this for you.

# Speech to text. Needed for Instagram reels and YouTube videos without captions.
# https://console.deepgram.com/signup
DEEPGRAM_API_KEY=

# Instagram reels only.
# https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Optional. Where capture files are saved. Defaults to ~/video-captures
CAPTURES_DIR=
